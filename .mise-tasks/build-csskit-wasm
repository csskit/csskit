#!/usr/bin/env bash
set -euo pipefail
#MISE description="Build csskit wasm for the csskit npm package (node + bundler targets)"

REPO_ROOT="$(git rev-parse --show-toplevel)"
PKG="$REPO_ROOT/packages/csskit"
NODE_OUT="$REPO_ROOT/target/wasm-bindgen-node"

missing=()
if [ ! -d "$(rustc --print target-libdir --target wasm32-unknown-unknown 2>/dev/null)" ]; then
  missing+=("  - wasm32-unknown-unknown Rust target: rustup target add wasm32-unknown-unknown")
fi
if ! command -v wasm-bindgen >/dev/null; then
  version="$(sed -n 's/^"cargo:wasm-bindgen-cli" = "\(.*\)"$/\1/p' "$REPO_ROOT/.mise.toml")"
  missing+=("  - wasm-bindgen: cargo install wasm-bindgen-cli --version ${version:-<see .mise.toml>}")
fi
if ! command -v wasm-opt >/dev/null; then
  missing+=("  - wasm-opt: install binaryen (brew install binaryen / apt install binaryen)")
fi
if [ ${#missing[@]} -gt 0 ]; then
  echo "build-csskit-wasm: missing required tools. Run \`mise install\` from $REPO_ROOT, or install manually:" >&2
  printf '%s\n' "${missing[@]}" >&2
  exit 1
fi

cargo build \
  --target wasm32-unknown-unknown \
  --release \
  -p csskit_wasm \
  --no-default-features \
  --features serde

wasm-bindgen \
  --out-dir "$NODE_OUT" \
  --target experimental-nodejs-module \
  "$REPO_ROOT/target/wasm32-unknown-unknown/release/csskit_wasm.wasm"

wasm-bindgen \
  --out-dir "$PKG/bundle" \
  --target bundler \
  "$REPO_ROOT/target/wasm32-unknown-unknown/release/csskit_wasm.wasm"

mv "$NODE_OUT/csskit_wasm.js" "$PKG/bundle/csskit_wasm_node.js"
rm -rf "$NODE_OUT"

wasm-opt \
  --enable-bulk-memory \
  --enable-nontrapping-float-to-int \
  -Oz \
  -o "$PKG/bundle/csskit_wasm_bg.wasm" \
  "$PKG/bundle/csskit_wasm_bg.wasm"

rm -f "$PKG/wasm.js" "$PKG/wasm.d.ts" "$PKG/csskit_wasm_bg.wasm.d.ts"
rm -f "$PKG/csskit_wasm_bg.wasm"
