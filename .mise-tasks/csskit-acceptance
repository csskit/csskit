#!/usr/bin/env bash
#MISE depends=["build"]
#MISE description="Run acceptance tests against `csskit`"
set -eu
set -o pipefail

CSSKIT="./target/debug/csskit"
PASS=$(printf '\033[32m✓\033[0m')
FAIL=$(printf '\033[31m✗\033[0m')
UPDATED=$(printf '\033[33m↻\033[0m')
passed=0
failed=0
updated=0

QUIET=false
UPDATE=false
for arg in "$@"; do
	case "$arg" in
	-q | --quiet) QUIET=true ;;
	-u | --update) UPDATE=true ;;
	esac
done

check_parse() {
	css_file="$1"
	if $CSSKIT fmt "$css_file" >/dev/null 2>&1; then
		echo " $PASS parse $css_file"
		passed=$((passed + 1))
	else
		echo " $FAIL parse $css_file"
		failed=$((failed + 1))
	fi
}

check_variant() {
	variant="$1"
	css_file="$2"
	base="$3"
	target_file="$base.$variant.css"

	[ -f "$target_file" ] || return 0

	if $UPDATE; then
		if new_output=$($CSSKIT "$variant" "$css_file" 2>/dev/null); then
			if diff -q <(printf '%s\n' "$new_output") "$target_file" >/dev/null 2>&1; then
				echo " $PASS $variant $css_file"
				passed=$((passed + 1))
			else
				printf '%s\n' "$new_output" >"$target_file"
				echo " $UPDATED $variant $css_file"
				updated=$((updated + 1))
			fi
		else
			echo " $FAIL $variant $css_file (update failed)"
			failed=$((failed + 1))
		fi
	elif diff_output=$($CSSKIT "$variant" "$css_file" 2>/dev/null | diff -Z --new-file --color=always --side-by-side --suppress-common-lines - "$target_file" 2>&1); then
		echo " $PASS $variant $css_file"
		passed=$((passed + 1))
	else
		echo " $FAIL $variant $css_file"
		$QUIET || echo "$diff_output"
		failed=$((failed + 1))
	fi
}

# Generic front-matter test runner.
# Fixture format: line 1 = full csskit args (word-split, css file appended),
# line 2 = ---, rest = expected output.
check_frontmatter() {
	label="$1"
	css_file="$2"
	fixture_file="$3"

	args=$(head -n1 "$fixture_file")
	expected=$(tail -n +3 "$fixture_file")

	run_fixture() { (set -f; eval "$CSSKIT --color never $args $(printf '%q' "$css_file")" 2>/dev/null); }

	if $UPDATE; then
		if actual=$(run_fixture); then
			if [ "$actual" = "$expected" ]; then
				echo " $PASS $label '$args' $css_file"
				passed=$((passed + 1))
			else
				{ printf '%s\n---\n' "$args"; printf '%s\n' "$actual"; } >"$fixture_file"
				echo " $UPDATED $label '$args' $css_file"
				updated=$((updated + 1))
			fi
		else
			echo " $FAIL $label '$args' $css_file (update failed)"
			failed=$((failed + 1))
		fi
	elif actual=$(run_fixture); then
		if [ "$actual" = "$expected" ]; then
			echo " $PASS $label '$args' $css_file"
			passed=$((passed + 1))
		else
			echo " $FAIL $label '$args' $css_file"
			if ! $QUIET; then
				echo "Expected:"
				echo "$expected"
				echo "Actual:"
				echo "$actual"
			fi
			failed=$((failed + 1))
		fi
	else
		echo " $FAIL $label '$args' $css_file (command failed)"
		failed=$((failed + 1))
	fi
}

check_check() {
	css_file="$1"
	check_file="$2"

	cks_basename=$(head -n1 "$check_file")
	expected=$(tail -n +3 "$check_file")
	cks_file="$(dirname "$css_file")/$cks_basename.cks"

	if [ ! -f "$cks_file" ]; then
		echo " $FAIL check $cks_basename $css_file (.cks file not found)"
		failed=$((failed + 1))
		return
	fi

	actual=$($CSSKIT --color never check "$cks_file" "$css_file" 2>&1) || true

	if $UPDATE; then
		if [ "$actual" = "$expected" ]; then
			echo " $PASS check $cks_basename $css_file"
			passed=$((passed + 1))
		else
			{ printf '%s\n---\n' "$cks_basename"; printf '%s\n' "$actual"; } >"$check_file"
			echo " $UPDATED check $cks_basename $css_file"
			updated=$((updated + 1))
		fi
	elif [ "$actual" = "$expected" ]; then
		echo " $PASS check $cks_basename $css_file"
		passed=$((passed + 1))
	else
		echo " $FAIL check $cks_basename $css_file"
		if ! $QUIET; then
			echo "Expected:"
			echo "$expected"
			echo "Actual:"
			echo "$actual"
		fi
		failed=$((failed + 1))
	fi
}

shopt -s nullglob

found_css=false
for css in coverage/basic/*.css coverage/popular/*.css; do
	case "$css" in *.min.css | *.fmt.css) continue ;; esac
	found_css=true
	base="${css%.css}"

	check_parse "$css"
	check_variant "fmt" "$css" "$base"
	check_variant "min" "$css" "$base"
	check_variant "tree" "$css" "$base"

	for fixture in "$base".json.*.txt; do
		check_frontmatter "json" "$css" "$fixture"
	done

	for fixture in "$base".find.*.txt; do
		check_frontmatter "find" "$css" "$fixture"
	done

	for fixture in "$base".check.*.txt; do
		check_check "$css" "$fixture"
	done
done

if ! $found_css; then
	echo "No CSS test files found!"
	exit 1
fi

total=$((passed + failed + updated))
if [ "$total" -gt 0 ]; then
	rate=$((100 * (passed + updated) / total))
	echo "Success rate: $rate%"
fi

[ "$total" -eq 0 ] && {
	echo "No tests were run!"
	exit 1
}

if $UPDATE; then
	echo "Results: $passed passed, $updated updated, $failed failed"
else
	echo "Results: $passed passed, $failed failed"
fi
exit $failed
