#[automatically_derived]
impl ::css_parse::SemanticEq for Foo {
    fn semantic_eq(&self, other: &Self) -> bool {
        use ::css_parse::SemanticEq;
        match (self, other) {
            (Foo::Bar { name: a_name, .. }, Foo::Bar { name: b_name, .. }) => {
                a_name.semantic_eq(&b_name)
            }
            _ => false,
        }
    }
}
