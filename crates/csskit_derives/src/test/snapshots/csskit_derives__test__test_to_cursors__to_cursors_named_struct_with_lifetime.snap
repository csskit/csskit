#[automatically_derived]
impl<'a> ::css_parse::ToCursors for Value<'a> {
    fn to_cursors(&self, s: &mut impl ::css_parse::CursorSink) {
        match self {
            Self { content, unit, .. } => {
                ::css_parse::ToCursors::to_cursors(content, s);
                ::css_parse::ToCursors::to_cursors(unit, s);
            }
        }
    }
}
