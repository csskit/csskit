#[automatically_derived]
impl ::css_parse::ToSpan for BaselinePosition {
    fn to_span(&self) -> ::css_parse::Span {
        use ::css_parse::{Span, ToSpan};
        match self {
            BaselinePosition::Both { last, first, .. } => {
                ToSpan::to_span(last) + ToSpan::to_span(first)
            }
        }
    }
}
