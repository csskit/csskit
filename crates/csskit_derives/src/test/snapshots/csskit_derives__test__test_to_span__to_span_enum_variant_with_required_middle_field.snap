#[automatically_derived]
impl ::css_parse::ToSpan for Rule {
    fn to_span(&self) -> ::css_parse::Span {
        use ::css_parse::{Span, ToSpan};
        match self {
            Rule::Block { open, close, .. } => {
                ToSpan::to_span(open) + ToSpan::to_span(close)
            }
        }
    }
}
