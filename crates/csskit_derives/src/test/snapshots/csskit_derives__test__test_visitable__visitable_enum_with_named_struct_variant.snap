#[automatically_derived]
impl<'a> crate::VisitableMut<'a> for FlexWrap {
    fn accept_mut<__V: crate::VisitMut<'a>>(
        &mut self,
        v: &mut __V,
    ) -> visit_flow::VisitFlow {
        use crate::VisitableMut;
        match self {
            Self::Nowrap(v0) => v0.accept_mut(v),
            Self::Wrap { wrap, balance, .. } => {
                visit_flow::try_visit!(wrap.accept_mut(v));
                visit_flow::try_visit!(balance.accept_mut(v));
                <visit_flow::VisitFlow as visit_flow::VisitFlowExt>::DESCEND
            }
            Self::WrapReverse { wrap_reverse, balance, .. } => {
                visit_flow::try_visit!(wrap_reverse.accept_mut(v));
                visit_flow::try_visit!(balance.accept_mut(v));
                <visit_flow::VisitFlow as visit_flow::VisitFlowExt>::DESCEND
            }
        }
    }
    fn element_node(&self) -> Option<crate::VisitNode<'_>> {
        use crate::VisitableMut;
        match self {
            Self::Nowrap(v0) => v0.element_node(),
            Self::Wrap { .. } => None,
            Self::WrapReverse { .. } => None,
        }
    }
}
#[automatically_derived]
impl crate::Visitable for FlexWrap {
    fn accept<__V: crate::Visit>(&self, v: &mut __V) -> visit_flow::VisitFlow {
        use crate::Visitable;
        match self {
            Self::Nowrap(v0) => {
                visit_flow::try_visit!(v0.accept(v));
            }
            Self::Wrap { wrap, balance, .. } => {
                visit_flow::try_visit!(wrap.accept(v));
                visit_flow::try_visit!(balance.accept(v));
            }
            Self::WrapReverse { wrap_reverse, balance, .. } => {
                visit_flow::try_visit!(wrap_reverse.accept(v));
                visit_flow::try_visit!(balance.accept(v));
            }
        }
        <visit_flow::VisitFlow as visit_flow::VisitFlowExt>::DESCEND
    }
}
