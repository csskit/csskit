impl Visit for V {
    fn visit_color(&mut self, c: &Color) -> ::visit_flow::VisitFlow {
        if c.is_empty() {
            return <::visit_flow::VisitFlow as ::visit_flow::VisitFlowExt>::DESCEND;
        }
        self.seen.push(c);
        <::visit_flow::VisitFlow as ::visit_flow::VisitFlowExt>::DESCEND
    }
}
