    pub foo: Option<::css_parse::T![Ident]>,
    #[cfg_attr(feature = "visitable", visit(skip))]
    #[atom(CssAtomSet::Bar)]
    pub bar: Option<::css_parse::T![Ident]>,
    #[cfg_attr(feature = "visitable", visit(skip))]
    #[atom(CssAtomSet::Baz)]
    pub baz: Option<::css_parse::T![Ident]>,
}
#[cfg(test)]
::stable_type_layout::register!(Foo);
