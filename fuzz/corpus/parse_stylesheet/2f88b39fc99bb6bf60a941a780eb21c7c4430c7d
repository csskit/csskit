/* src/flex.css */
.flex-row,
.f-row {
  display: flex;
  flex-direction: row;
  gap: var(--gap);
  & > * {
    margin: 0;
  }
}
.flex-column,
.f-col {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  & > * {
    margin: 0;
  }
}
.flex-switch,
.f-switch {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  --f-switch-threshold: 55ch;
  --flex-switch-threshold:ter-spin-button {
  height: auto;
}

[type="search"] {
