.table {
  display: table;
  width: 100%;
  margin: 0;
}
.row,
.rows > * {
  display: table-row;
  &:not(:last-child):not([specificity-hack]) > * {
    margin-bottom: var(--gap);
  }
  & > *:not([specificity-hack]) {
    display: table-cell;
    vertical-align: top;
  }
  & > * + *:not([specificity-hack]) {
    margin-inline-start: var(--gap);
    display: inline-block;
  }
}
