  width: 24px;
  height: 24px;
  text-align: center;
  border-radius: 50%;
  transition: font-weight .2s ease-in-out;
  &:hover,
  &:focus-visible {
    box-shadow: none;
    outline: var(--interactive-border-width) var(--interactive-border-style) var(--accent);
    outline-offset: 6px;
  }
  &:active {
    box-shadow: none;
    outline-offset: 3px;
    background: none;
  }
  &[aria-pressed=true] {
    box-shadow: none;
    transform: none;
  }
  &:is(.plain, .info, .ok, .warn, .bad) {
    color: var(--accent);
  }
  &:is(.big, .\<big\>) {
    font-size: 44px;
    width: 44px;
    height: 44px;
    padding-inline: 0;
  }
}

