@keyframes blazingStarText {
  1% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }
  10% {
    text-shadow: 0px 0px 0vh rgba(255, 255, 0,0);
    transform: scale(1);
  }
  20% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }
  30% {
    text-shadow: 0px 0px 0vh rgba(255, 255, 0,0);
    transform: scale(1);
  }
  40% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }
  50% {
    text-shadow: 0px 0px 0vh rgba(255, 255, 0,0);
    transform: scale(1);
  }
  60% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }

  70% {
    text-shadow: 0px 0px 0vh rgba(255, 255, 0,0);
    transform: scale(1);
  }
  80% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }

  90% {
    text-shadow: 0px 0px 0vh rgba(255, 255, 0,0);
    transform: scale(1);
  }
  99% {
    text-shadow: 0px 0px 20vh rgba(255, 255, 0,1);
    transform: scale(1);
  }
}