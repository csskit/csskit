.page-link.active,
.active > .page-link {
  z-index: 3;
  color: var(--bs-pagination-active-color);
  background-color: var(--bs-pagination-active-bg);
  border-color: var(--bs-pagination-active-border-color);
  background-clip: var(--bs-pagination-active-bg-clip);
  -webkit-font-smoothing: var(--bs-pagination-active-webkit-font-smoothing);
  -moz-osx-font-smoothing: var(--bs-pagination-active-moz-osx-font-smoothing);
}