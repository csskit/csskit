.ts-table,
.ts-table :is(thead, tbody, tfoot, tr, th, td) {
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
    border-collapse: collapse;
    border-spacing: 0;
    border-color: inherit;
    text-align: left;
    font-weight: inherit;
    font-size: 14px;

    -webkit-border-horizontal-spacing: 0;
    -webkit-border-vertical-spacing: 0;
}