.table.table-head-fixed thead tr:nth-child(1) th {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: var(--bs-body-bg, #fff);
  border-bottom: 0;
  box-shadow: inset 0 1px 0 var(--bs-border-color, var(--bs-border-color)), inset 0 -1px 0 var(--bs-border-color, var(--bs-border-color));
}