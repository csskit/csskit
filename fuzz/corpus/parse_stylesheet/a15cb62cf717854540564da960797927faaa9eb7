.callout.callout[data-callout="timeline"]>.callout-content {
  border-left: none;
  display: -ms-grid;
  display: grid;
  -ms-grid-columns: auto auto 1fr;
  grid-template-columns: 0.3fr auto 1fr;
  -webkit-column-gap: 1.5rem;
  column-gap: 1.5rem;
  row-gap: 0.25rem;
  margin: 2.3rem 1rem 0 0;
  padding: 0;
}