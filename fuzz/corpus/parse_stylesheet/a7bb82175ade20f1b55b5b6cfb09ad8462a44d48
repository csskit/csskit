ol > *:not(li, script, template)::after, ul > *:not(li, script, template)::after {
  display: block;
  font-size: 1rem;
  font-family: verdana, geneva, tahoma, sans-serif;
  font-weight: 700;
  font-style: initial;
  padding-block: var(--checka11y-space-4);
  padding-inline: var(--checka11y-space-6);
  border-radius: 0.75rem;
  letter-spacing: initial;
  text-decoration: none;
  text-transform: initial;
  text-shadow: none;
  content: "ERROR (E0011): List markup invalid. Ensure <li>, <script> or <template> are the only direct children of <ul> or <ol>." !important;
  color: var(--checka11y-text-error);
  border-block: 0.4rem solid var(--checka11y-border-error);
  border-inline: 0.4rem solid var(--checka11y-border-error);
  background-color: var(--checka11y-bg-error);
}