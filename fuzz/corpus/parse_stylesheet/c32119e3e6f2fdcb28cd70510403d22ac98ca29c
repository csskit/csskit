::after {
  text-decoration: inherit;
  vertical-align: inherit;
}
:root {
  cursor: default;
  overflow-wrap: break-word;
  -webkit-tap-highlight-color: transparent;
  text-size-adjust: none;
  -webkit-text-size-adjust: none;
}
