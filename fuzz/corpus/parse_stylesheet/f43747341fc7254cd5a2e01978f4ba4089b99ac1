.autoscroller::after {
  display: block;
  content: "";
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: no-repeat center var(--autoscroll-background-image) rgba(249,249,250,.8);
  border: solid rgba(0,0,0,.4) 1.5px;
  translate: -11px -21px !important;
  box-shadow: 0 0 4px rgba(0,0,0,.2);
}